generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Veicle {
  id         String   @id
  modelo     String
  cor        String
  quantidade Int
  q_port     Int
  data       DateTime @default(now())

  @@map("veicles")
}

model Product {
  id         String @id
  name       String
  mark       String
  quantidade Int

  @@map("products")
}

model Maintenance {
  id        String   @id
  veiculo   String
  tipo      String
  descricao String
  data      DateTime

  @@map("maintenance")
}
